# Virtual Environments
venv/
.venv/
canecare-backend/venv/

# Environment files with secrets
.env
canecare-backend/.env

# Uploads directory contents except .gitkeep
uploads/*
!uploads/.gitkeep
canecare-backend/uploads/*
!canecare-backend/uploads/.gitkeep

# Models directory contents except .gitkeep
models/*
!models/.gitkeep
canecare-backend/models/*
!canecare-backend/models/.gitkeep

# Python cache & compiled files
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Local databases
*.db
*.sqlite3

