# CaneCare AI Backend - Environment Configuration Template
PROJECT_NAME="CaneCare AI"
VERSION="1.0.0"
DEBUG=True

# JWT Secret Key (change this in production!)
SECRET_KEY="generate-a-strong-random-key-here"

# Token Expiration in Minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (SQLite database file stored locally)
DATABASE_URL="sqlite:///./canecare.db"

# Allowed Origins for CORS (comma-separated or * for all in dev)
ALLOWED_ORIGINS="*"

# Uploads directory
UPLOAD_DIR="./uploads"

# Models directory
MODEL_DIR="./models"

